// EarthWare Database Schema v1.1
// Aligned with PRD v1.1 — February 2026
// https://dbml.dbdiagram.io/docs

// =============================================================================
// ENUMS
// =============================================================================

enum slab_status {
  "in_transit"
  "available"
  "on_hold"
  "reserved"
  "sold"
  "cut_consumed"
  "returned"
  "damaged"
  "consigned"
}

enum slab_finish {
  "polished"
  "honed"
  "leathered"
  "brushed"
  "flamed"
}

enum material_type {
  "quartzite"
  "granite"
  "marble"
  "dolomite"
  "crystal"
  "soapstone"
  "quartz"
  "porcelain"
  "travertine"
  "onyx"
  "slate"
  "limestone"
}

enum color_family {
  "white"
  "off_white"
  "beige"
  "cream"
  "light_grey"
  "grey"
  "dark_grey"
  "black"
  "brown"
  "gold"
  "blue"
  "green"
  "red"
  "pink"
  "multi"
}

enum quality_grade {
  "premium"
  "standard"
  "commercial"
  "remnant"
}

enum dimension_stage {
  "purchased"
  "received"
  "sold"
  "returned"
}

enum media_type {
  "photo"
  "slabsmith"
  "certification"
  "document"
}

enum location_type {
  "warehouse"
  "yard"
  "consignment"
  "in_transit"
}

enum invoice_status {
  "draft"
  "issued"
  "paid"
  "partially_paid"
  "overdue"
  "voided"
}

enum payment_terms {
  "cod"
  "net_15"
  "net_30"
  "net_45"
  "net_60"
  "letter_of_credit"
  "credit_card"
}

enum container_size {
  "20ft"
  "40ft"
  "40ft_hc"
}

enum container_status {
  "booked"
  "loaded"
  "in_transit"
  "arrived_at_port"
  "customs_hold"
  "customs_cleared"
  "in_transit_domestic"
  "delivered"
  "received"
}

enum customs_status {
  "pending"
  "cleared"
  "held"
  "released"
}

enum po_status {
  "draft"
  "submitted"
  "confirmed"
  "partially_received"
  "received"
  "closed"
  "cancelled"
}

enum sales_order_status {
  "draft"
  "confirmed"
  "ready_for_fulfillment"
  "partially_shipped"
  "shipped"
  "invoiced"
  "closed"
  "cancelled"
}

enum quote_status {
  "draft"
  "sent"
  "expired"
  "accepted"
  "declined"
  "revised"
}

enum hold_type {
  "courtesy"
  "standard"
  "deposit"
  "project"
  "builder"
}

enum hold_status {
  "active"
  "expired"
  "converted"
  "released"
}

enum deposit_status {
  "pending"
  "received"
  "refunded"
  "applied"
}

enum customer_type {
  "fabricator"
  "builder"
  "designer"
  "retail_homeowner"
  "contractor"
  "architect"
}

enum customer_tier {
  "platinum"
  "gold"
  "silver"
  "standard"
}

enum contact_role {
  "primary"
  "billing"
  "shipping"
  "decision_maker"
  "buyer"
  "accounts_payable"
  "site_contact"
}

enum payment_method {
  "check"
  "wire"
  "credit_card"
  "cash"
  "ach"
}

enum movement_type {
  "receipt"
  "transfer"
  "bin_move"
  "pick"
  "ship"
  "return"
  "adjustment"
  "consignment_out"
  "consignment_return"
}

enum product_category {
  "sink"
  "edge_profile"
  "adhesive"
  "sealer"
  "support_bracket"
  "sample"
  "other"
}

enum cost_allocation_method {
  "by_sqft"
  "by_value"
  "by_weight"
  "by_unit_count"
  "fixed_per_unit"
}

// --- Portal enums ---

enum portal_role {
  "trade_customer"
  "end_customer"
}

enum portal_invitation_status {
  "pending"
  "accepted"
  "expired"
  "revoked"
}

enum hold_request_status {
  "pending_review"
  "approved"
  "declined"
  "expired"
}

enum delivery_request_status {
  "requested"
  "confirmed"
  "alternative_proposed"
  "declined"
  "completed"
  "cancelled"
}

enum delivery_window {
  "morning"
  "afternoon"
  "full_day"
}

enum thread_type {
  "general_inquiry"
  "hold_thread"
  "order_thread"
  "delivery_thread"
  "slab_inquiry"
}

enum message_attachment_type {
  "file"
  "entity_reference"
}

enum entity_reference_type {
  "slab"
  "hold"
  "order"
  "invoice"
  "quote"
  "delivery_request"
}

// =============================================================================
// CORE: USERS & AUTH
// =============================================================================

Table users {
  id uuid [primary key]
  email varchar(255) [not null, unique]
  password_hash varchar(255) [not null]
  first_name varchar(255) [not null]
  last_name varchar(255) [not null]
  role_id uuid [ref: > roles.id]
  is_active boolean [default: true]
  two_factor_enabled boolean [default: false]
  two_factor_secret varchar(255)
  last_login_at timestamp
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table roles {
  id uuid [primary key]
  name varchar(100) [not null, unique]
  permissions jsonb [not null, note: "JSON array of permission strings"]
  description text
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table audit_log {
  id uuid [primary key]
  user_id uuid [ref: > users.id]
  action varchar(255) [not null]
  entity_type varchar(100)
  entity_id uuid
  old_values jsonb
  new_values jsonb
  ip_address inet
  created_at timestamp [default: `now()`]

  indexes {
    (entity_type, entity_id)
    created_at
    user_id
  }
}

// =============================================================================
// CORE: ADDRESSES
// =============================================================================

Table addresses {
  id uuid [primary key]
  street_line_1 varchar(255) [not null]
  street_line_2 varchar(255)
  city varchar(255) [not null]
  state_province varchar(255)
  postal_code varchar(50)
  country varchar(2) [not null, note: "ISO 3166-1 alpha-2"]
  address_type varchar(50) [note: "billing, shipping, warehouse, factory, port, office"]
  addressable_type varchar(100) [note: "Polymorphic: customer, supplier, location"]
  addressable_id uuid [note: "FK to the owning entity"]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]

  indexes {
    (addressable_type, addressable_id)
  }
}

// =============================================================================
// INVENTORY: MATERIALS, BUNDLES, SLABS
// =============================================================================

Table materials {
  id uuid [primary key]
  material_name varchar(255) [not null]
  material_type material_type [not null]
  color_family color_family
  description text
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]

  indexes {
    (material_name, material_type) [unique]
  }
}

Table bundles {
  id uuid [primary key]
  bundle_number varchar(255) [not null, note: "Manufacturer bundle/lot identifier"]
  material_id uuid [ref: > materials.id]
  supplier_id uuid [ref: > suppliers.id]
  expected_slab_count int
  notes text
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]

  indexes {
    bundle_number
  }
}

Table slabs {
  id uuid [primary key]
  bundle_id uuid [ref: > bundles.id]
  bundle_position int [note: "Sequential position within bundle for bookmatch ordering"]
  container_id uuid [ref: > containers.id]
  material_id uuid [ref: > materials.id]
  supplier_id uuid [ref: > suppliers.id]
  location_id uuid [ref: > locations.id]
  bin_slot varchar(50) [note: "Physical position e.g. A-15-3"]
  consignment_location_id uuid [ref: > locations.id]

  // Identification
  barcode varchar(255) [unique]

  // Attributes
  finish slab_finish [not null]
  quality_grade quality_grade [not null]
  origin_country varchar(2) [note: "ISO 3166-1 alpha-2"]
  quarry_name varchar(255)
  status slab_status [not null, default: 'in_transit']

  // Financial — all in cents
  fob_cost_cents bigint
  freight_cost_cents bigint
  duty_cost_cents bigint
  other_cost_cents bigint
  landed_cost_cents bigint [note: "Sum of all cost components"]
  list_price_cents bigint [note: "Standard selling price per sqft"]
  minimum_price_cents bigint [note: "Floor price per sqft"]

  // Portal
  portal_visible boolean [default: false]

  // Metadata
  notes text
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]

  indexes {
    material_id
    status
    location_id
    bundle_id
    portal_visible
    (bundle_id, bundle_position) [unique]
  }
}

Table slab_dimensions {
  id uuid [primary key]
  slab_id uuid [ref: > slabs.id, note: "Many dimension records per slab (one per stage)"]
  stage dimension_stage [not null]
  length_mm decimal(7,2) [not null]
  width_mm decimal(7,2) [not null]
  area_mm2 decimal [note: "GENERATED ALWAYS AS (length_mm * width_mm) STORED"]
  thickness_mm decimal(5,2) [not null]
  measured_by uuid [ref: > users.id]
  measured_at timestamp

  indexes {
    (slab_id, stage) [unique]
  }
}

Table slab_media {
  id uuid [primary key]
  slab_id uuid [ref: > slabs.id]
  media_type media_type [not null]
  file_path varchar(1024) [not null, note: "S3-compatible path"]
  original_filename varchar(255)
  mime_type varchar(100)
  file_size_bytes bigint
  is_primary boolean [default: false]
  sort_order int [default: 0]
  created_at timestamp [default: `now()`]

  indexes {
    slab_id
  }
}

// =============================================================================
// INVENTORY: LOCATIONS
// =============================================================================

Table locations {
  id uuid [primary key]
  name varchar(255) [not null]
  location_type location_type [not null]
  address_id uuid [ref: > addresses.id]
  contact_name varchar(255)
  contact_phone varchar(50)
  contact_email varchar(255)
  bin_configuration jsonb [note: "Layout of storage bins/slots"]
  is_active boolean [default: true]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

// =============================================================================
// INVENTORY: NON-SLAB PRODUCTS
// =============================================================================

Table products {
  id uuid [primary key]
  sku varchar(100) [not null, unique]
  name varchar(255) [not null]
  description text
  category product_category [not null]
  unit_of_measure varchar(50) [default: 'each']
  quantity_on_hand int [default: 0]
  reorder_point int
  cost_cents bigint
  list_price_cents bigint
  is_active boolean [default: true]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]

  indexes {
    sku [unique]
    category
  }
}

// =============================================================================
// PURCHASING: SUPPLIERS, POs, CONTAINERS
// =============================================================================

Table suppliers {
  id uuid [primary key]
  company_name varchar(255) [not null]
  trade_name varchar(255)
  country varchar(2) [note: "ISO 3166-1 alpha-2"]
  default_payment_terms payment_terms
  default_currency varchar(3) [default: 'USD', note: "ISO 4217"]
  tax_id varchar(100)
  bank_details_encrypted jsonb [note: "Encrypted wire transfer information"]
  notes text
  is_active boolean [default: true]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table supplier_contacts {
  id uuid [primary key]
  supplier_id uuid [ref: > suppliers.id]
  first_name varchar(255) [not null]
  last_name varchar(255) [not null]
  email varchar(255)
  phone varchar(50)
  role varchar(100)
  is_primary boolean [default: false]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]

  indexes {
    supplier_id
  }
}

Table purchase_orders {
  id uuid [primary key]
  po_number varchar(50) [not null, unique]
  supplier_id uuid [ref: > suppliers.id]
  status po_status [not null, default: 'draft']
  currency varchar(3) [default: 'USD']
  payment_terms payment_terms
  incoterms varchar(20) [note: "FOB, CIF, FCA, etc."]
  port_of_loading varchar(255)
  expected_container_size container_size

  // Aggregate cost fields — in cents
  fob_total_cents bigint
  freight_total_cents bigint
  duty_total_cents bigint
  insurance_total_cents bigint
  other_costs_cents bigint

  notes text
  supplier_instructions text
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]

  indexes {
    supplier_id
    status
    po_number [unique]
  }
}

Table po_items {
  id uuid [primary key]
  purchase_order_id uuid [ref: > purchase_orders.id]
  material_id uuid [ref: > materials.id]
  description varchar(255)
  quantity int [not null]
  unit varchar(50) [default: 'slab']
  unit_price_cents bigint [not null]
  line_total_cents bigint [not null]
  created_at timestamp [default: `now()`]

  indexes {
    purchase_order_id
  }
}

Table po_documents {
  id uuid [primary key]
  purchase_order_id uuid [ref: > purchase_orders.id]
  document_type varchar(100) [not null, note: "proforma_invoice, packing_list, bill_of_lading, certificate"]
  file_path varchar(1024) [not null]
  original_filename varchar(255)
  uploaded_at timestamp [default: `now()`]

  indexes {
    purchase_order_id
  }
}

Table containers {
  id uuid [primary key]
  purchase_order_id uuid [ref: > purchase_orders.id]
  number varchar(255) [not null, note: "Shipping container ID"]
  container_size container_size
  seal_number varchar(255)
  vessel_name varchar(255)
  voyage_number varchar(255)
  port_of_loading varchar(255)
  port_of_discharge varchar(255)
  destination_location_id uuid [ref: > locations.id]
  container_status container_status [not null, default: 'booked']
  customs_status customs_status
  customs_number varchar(255)

  // Dates
  etd date [note: "Estimated departure"]
  eta date [note: "Estimated arrival at port"]
  actual_arrival_date date [note: "Actual arrival at port"]
  delivery_date date [note: "Delivered to warehouse"]

  notes text
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]

  indexes {
    container_status
    purchase_order_id
    eta
  }
}

// Container-level cost items used for landed cost allocation
Table container_costs {
  id uuid [primary key]
  container_id uuid [ref: > containers.id]
  cost_type varchar(100) [not null, note: "ocean_freight, import_duty, customs_brokerage, insurance, drayage, handling, storage"]
  amount_cents bigint [not null]
  allocation_method cost_allocation_method [not null, default: 'by_sqft']
  notes varchar(255)
  created_at timestamp [default: `now()`]

  indexes {
    container_id
  }
}

// =============================================================================
// CUSTOMERS & CRM
// =============================================================================

Table customers {
  id uuid [primary key]
  company_name varchar(255) [not null]
  customer_type customer_type [not null]
  tier customer_tier [not null, default: 'standard']
  tax_exempt boolean [default: false]
  tax_id varchar(100) [note: "Resale certificate number"]
  payment_terms payment_terms [default: 'cod']
  credit_limit_cents bigint [default: 0]
  price_level_id uuid [note: "FK to a pricing tier if implemented"]
  sales_rep_id uuid [ref: > users.id]
  referral_source varchar(255)
  is_active boolean [default: true]
  notes text
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]

  indexes {
    customer_type
    tier
    sales_rep_id
    is_active
  }
}

Table contacts {
  id uuid [primary key]
  customer_id uuid [ref: > customers.id]
  first_name varchar(255) [not null]
  last_name varchar(255) [not null]
  email varchar(255)
  phone varchar(50)
  role contact_role [default: 'primary']
  communication_preference varchar(50) [note: "email, phone, text"]
  is_portal_eligible boolean [default: false]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]

  indexes {
    customer_id
    email
  }
}

// Interaction log for CRM (calls, emails, visits, follow-ups)
Table customer_interactions {
  id uuid [primary key]
  customer_id uuid [ref: > customers.id]
  contact_id uuid [ref: > contacts.id]
  user_id uuid [ref: > users.id, note: "Staff member who logged this"]
  interaction_type varchar(50) [not null, note: "phone_call, email, showroom_visit, follow_up"]
  subject varchar(255)
  notes text
  follow_up_date date
  created_at timestamp [default: `now()`]

  indexes {
    customer_id
    created_at
  }
}

// =============================================================================
// SALES: QUOTES
// =============================================================================

Table quotes {
  id uuid [primary key]
  quote_number varchar(50) [not null, unique]
  customer_id uuid [ref: > customers.id]
  sales_rep_id uuid [ref: > users.id]
  status quote_status [not null, default: 'draft']
  expiry_date date
  subtotal_cents bigint
  tax_cents bigint
  delivery_cents bigint
  total_cents bigint
  payment_terms payment_terms
  notes text
  terms_text text [note: "Validity, disclaimers, special conditions"]
  previous_version_id uuid [ref: > quotes.id, note: "Links revised quotes to their predecessor"]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]

  indexes {
    customer_id
    status
    quote_number [unique]
  }
}

Table quote_items {
  id uuid [primary key]
  quote_id uuid [ref: > quotes.id]
  slab_id uuid [ref: > slabs.id]
  product_id uuid [ref: > products.id]
  description varchar(255)
  quantity decimal(10,2) [not null, default: 1]
  unit_price_cents bigint [not null]
  line_total_cents bigint [not null]
  sort_order int [default: 0]
  created_at timestamp [default: `now()`]

  indexes {
    quote_id
  }
}

// =============================================================================
// SALES: HOLDS
// =============================================================================

Table holds {
  id uuid [primary key]
  customer_id uuid [ref: > customers.id]
  hold_type hold_type [not null, default: 'courtesy']
  status hold_status [not null, default: 'active']
  expiry_date timestamp [not null]
  deposit_amount_cents bigint [default: 0]
  deposit_status deposit_status
  notes text [note: "Project name, special instructions"]
  created_by uuid [ref: > users.id]
  reminder_sent boolean [default: false]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]

  indexes {
    customer_id
    status
    expiry_date
  }
}

// Many-to-many: a hold can cover multiple slabs
Table hold_slabs {
  id uuid [primary key]
  hold_id uuid [ref: > holds.id]
  slab_id uuid [ref: > slabs.id]

  indexes {
    (hold_id, slab_id) [unique]
    slab_id
  }
}

// =============================================================================
// SALES: ORDERS
// =============================================================================

Table sales_orders {
  id uuid [primary key]
  order_number varchar(50) [not null, unique]
  customer_id uuid [ref: > customers.id]
  sales_rep_id uuid [ref: > users.id]
  status sales_order_status [not null, default: 'draft']
  ship_to_address_id uuid [ref: > addresses.id]
  bill_to_address_id uuid [ref: > addresses.id]
  payment_terms payment_terms

  // Financials — in cents
  subtotal_cents bigint
  discount_cents bigint [default: 0]
  tax_cents bigint
  delivery_cents bigint [default: 0]
  total_cents bigint

  // Delivery
  requested_delivery_date date
  delivery_method varchar(100) [note: "pickup, company_delivery, third_party"]
  delivery_instructions text

  // Linked entities
  hold_id uuid [ref: > holds.id]
  quote_id uuid [ref: > quotes.id]

  notes text
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]

  indexes {
    customer_id
    status
    order_number [unique]
    created_at
  }
}

Table order_items {
  id uuid [primary key]
  order_id uuid [ref: > sales_orders.id]
  slab_id uuid [ref: > slabs.id]
  product_id uuid [ref: > products.id]
  description varchar(255)
  quantity decimal(10,2) [not null, default: 1]
  list_price_cents bigint
  discount_cents bigint [default: 0]
  net_price_cents bigint [not null]
  line_total_cents bigint [not null]
  sort_order int [default: 0]
  created_at timestamp [default: `now()`]

  indexes {
    order_id
    slab_id
  }
}

// =============================================================================
// SALES: INVOICES & PAYMENTS
// =============================================================================

Table invoices {
  id uuid [primary key]
  invoice_number varchar(50) [not null, unique]
  customer_id uuid [ref: > customers.id]
  order_id uuid [ref: > sales_orders.id, note: "Nullable — direct invoices have no order"]
  status invoice_status [not null, default: 'draft']
  invoice_date date [not null]
  due_date date [not null]
  customer_po_number varchar(100) [note: "Customer's PO reference"]
  payment_terms payment_terms
  payment_instructions text

  // Financials
  subtotal_cents bigint
  tax_cents bigint
  total_cents bigint

  // Timestamps
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
  issued_at timestamp
  paid_at timestamp
  voided_at timestamp

  indexes {
    customer_id
    status
    due_date
    invoice_number [unique]
  }
}

Table invoice_lines {
  id uuid [primary key]
  invoice_id uuid [ref: > invoices.id]
  slab_id uuid [ref: > slabs.id]
  product_id uuid [ref: > products.id]
  description varchar(255)
  quantity decimal(10,2) [not null, default: 1]
  unit_price_cents bigint [not null]
  amount_cents bigint [not null]
  tax_cents bigint [default: 0]
  created_at timestamp [default: `now()`]

  indexes {
    invoice_id
  }
}

Table payments {
  id uuid [primary key]
  invoice_id uuid [ref: > invoices.id]
  customer_id uuid [ref: > customers.id]
  amount_cents bigint [not null]
  payment_method payment_method [not null]
  reference_number varchar(255) [note: "Check number, wire ref, transaction ID"]
  payment_date date [not null]
  notes text
  created_at timestamp [default: `now()`]

  indexes {
    invoice_id
    customer_id
    payment_date
  }
}

Table credit_memos {
  id uuid [primary key]
  credit_memo_number varchar(50) [not null, unique]
  customer_id uuid [ref: > customers.id]
  invoice_id uuid [ref: > invoices.id, note: "Original invoice being credited"]
  amount_cents bigint [not null]
  reason text
  created_at timestamp [default: `now()`]

  indexes {
    customer_id
  }
}

// =============================================================================
// WAREHOUSE OPERATIONS
// =============================================================================

Table inventory_movements {
  id uuid [primary key]
  movement_type movement_type [not null]
  slab_id uuid [ref: > slabs.id]
  from_location_id uuid [ref: > locations.id]
  from_bin varchar(50)
  to_location_id uuid [ref: > locations.id]
  to_bin varchar(50)
  performed_by uuid [ref: > users.id]
  reference_type varchar(100) [note: "order, transfer_request, cycle_count, etc."]
  reference_id uuid
  notes text
  created_at timestamp [default: `now()`]

  indexes {
    slab_id
    movement_type
    created_at
    (reference_type, reference_id)
  }
}

Table cycle_counts {
  id uuid [primary key]
  location_id uuid [ref: > locations.id]
  count_type varchar(50) [not null, note: "scheduled, random, full_physical"]
  status varchar(50) [not null, default: 'in_progress', note: "in_progress, completed, cancelled"]
  initiated_by uuid [ref: > users.id]
  completed_at timestamp
  notes text
  created_at timestamp [default: `now()`]

  indexes {
    location_id
    status
  }
}

Table cycle_count_items {
  id uuid [primary key]
  cycle_count_id uuid [ref: > cycle_counts.id]
  slab_id uuid [ref: > slabs.id]
  expected_location_id uuid [ref: > locations.id]
  expected_bin varchar(50)
  actual_location_id uuid [ref: > locations.id]
  actual_bin varchar(50)
  is_discrepancy boolean [default: false]
  resolution_notes text
  adjustment_approved_by uuid [ref: > users.id]
  created_at timestamp [default: `now()`]

  indexes {
    cycle_count_id
  }
}

// =============================================================================
// ACCOUNTS PAYABLE (Supplier-side)
// =============================================================================

Table supplier_invoices {
  id uuid [primary key]
  supplier_id uuid [ref: > suppliers.id]
  purchase_order_id uuid [ref: > purchase_orders.id]
  invoice_number varchar(255) [not null]
  invoice_date date [not null]
  due_date date [not null]
  amount_cents bigint [not null]
  currency varchar(3) [default: 'USD']
  status varchar(50) [not null, default: 'pending', note: "pending, approved, paid, voided"]
  expense_category varchar(100)
  paid_at timestamp
  notes text
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]

  indexes {
    supplier_id
    status
    due_date
  }
}

// =============================================================================
// CUSTOMER PORTAL
// =============================================================================

Table portal_users {
  id uuid [primary key]
  contact_id uuid [ref: > contacts.id]
  customer_id uuid [ref: > customers.id]
  email varchar(255) [not null, unique]
  password_hash varchar(255) [not null]
  role portal_role [not null]
  fabricator_id uuid [ref: > customers.id, note: "Set when role=end_customer; the fabricator who invited them"]
  two_factor_enabled boolean [default: false]
  two_factor_secret varchar(255)
  permissions jsonb [note: "Individually configurable permissions per portal user"]
  is_active boolean [default: true]
  last_login_at timestamp
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]

  indexes {
    customer_id
    contact_id
    role
    email [unique]
  }
}

Table portal_invitations {
  id uuid [primary key]
  customer_id uuid [ref: > customers.id]
  invited_by_user_id uuid [ref: > users.id, note: "Internal user who sent the invite"]
  invited_by_portal_user_id uuid [ref: > portal_users.id, note: "Fabricator who invited an end customer"]
  email varchar(255) [not null]
  role portal_role [not null]
  status portal_invitation_status [not null, default: 'pending']
  token varchar(255) [not null, unique, note: "Unique invitation token"]
  expires_at timestamp [not null]
  accepted_at timestamp
  created_at timestamp [default: `now()`]

  indexes {
    token [unique]
    email
    status
  }
}

Table portal_favorites {
  id uuid [primary key]
  portal_user_id uuid [ref: > portal_users.id]
  slab_id uuid [ref: > slabs.id]
  created_at timestamp [default: `now()`]

  indexes {
    (portal_user_id, slab_id) [unique]
  }
}

// =============================================================================
// PORTAL: HOLD REQUESTS
// =============================================================================

Table hold_requests {
  id uuid [primary key]
  customer_id uuid [ref: > customers.id]
  portal_user_id uuid [ref: > portal_users.id]
  hold_id uuid [ref: > holds.id, note: "Set when approved — links to the created hold"]
  project_name varchar(255)
  notes text
  requested_hold_type hold_type
  status hold_request_status [not null, default: 'pending_review']
  reviewed_by uuid [ref: > users.id]
  review_notes text
  reviewed_at timestamp
  created_at timestamp [default: `now()`]

  indexes {
    customer_id
    status
    created_at
  }
}

// Many-to-many: slabs requested in a hold request
Table hold_request_slabs {
  id uuid [primary key]
  hold_request_id uuid [ref: > hold_requests.id]
  slab_id uuid [ref: > slabs.id]

  indexes {
    (hold_request_id, slab_id) [unique]
    slab_id
  }
}

// =============================================================================
// PORTAL: DELIVERY REQUESTS
// =============================================================================

Table delivery_requests {
  id uuid [primary key]
  order_id uuid [ref: > sales_orders.id]
  customer_id uuid [ref: > customers.id]
  portal_user_id uuid [ref: > portal_users.id]
  requested_date date [not null]
  requested_window delivery_window
  delivery_address_id uuid [ref: > addresses.id]
  access_instructions text
  status delivery_request_status [not null, default: 'requested']
  confirmed_date date
  confirmed_window varchar(100)
  notes text
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]

  indexes {
    order_id
    customer_id
    status
    requested_date
  }
}

// =============================================================================
// PORTAL: MESSAGING
// =============================================================================

Table message_threads {
  id uuid [primary key]
  thread_type thread_type [not null, default: 'general_inquiry']
  customer_id uuid [ref: > customers.id]
  subject varchar(255)

  // Polymorphic entity link — the business object this thread is about
  entity_type entity_reference_type [note: "slab, hold, order, delivery_request, etc."]
  entity_id uuid

  // Routing
  assigned_to uuid [ref: > users.id, note: "Internal staff member handling this thread"]
  is_closed boolean [default: false]
  closed_at timestamp

  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]

  indexes {
    customer_id
    (entity_type, entity_id)
    assigned_to
    updated_at
  }
}

Table messages {
  id uuid [primary key]
  thread_id uuid [ref: > message_threads.id]

  // Sender is one of: internal user OR portal user
  sender_user_id uuid [ref: > users.id]
  sender_portal_user_id uuid [ref: > portal_users.id]

  body text [not null, note: "Rich text content"]
  is_internal_note boolean [default: false, note: "If true, not visible to portal users"]
  created_at timestamp [default: `now()`]

  indexes {
    thread_id
    created_at
  }
}

Table message_read_receipts {
  id uuid [primary key]
  message_id uuid [ref: > messages.id]
  reader_user_id uuid [ref: > users.id]
  reader_portal_user_id uuid [ref: > portal_users.id]
  read_at timestamp [not null]

  indexes {
    (message_id, reader_user_id)
    (message_id, reader_portal_user_id)
  }
}

Table message_attachments {
  id uuid [primary key]
  message_id uuid [ref: > messages.id]
  attachment_type message_attachment_type [not null]

  // For file attachments
  file_path varchar(1024)
  original_filename varchar(255)
  mime_type varchar(100)
  file_size_bytes bigint

  // For entity references
  entity_ref_type entity_reference_type
  entity_ref_id uuid

  created_at timestamp [default: `now()`]

  indexes {
    message_id
  }
}

// =============================================================================
// PORTAL: FABRICATOR SUB-PORTAL
// =============================================================================

// Fabricator-curated slab selections visible to specific end customers
Table fabricator_end_customer_selections {
  id uuid [primary key]
  fabricator_id uuid [ref: > customers.id, note: "The fabricator customer"]
  portal_user_id uuid [ref: > portal_users.id, note: "The end customer portal account"]
  slab_id uuid [ref: > slabs.id]
  project_name varchar(255)
  created_at timestamp [default: `now()`]

  indexes {
    (fabricator_id, portal_user_id, slab_id) [unique]
    portal_user_id
  }
}

// Fabricator pricing for their end customers
Table fabricator_slab_pricing {
  id uuid [primary key]
  fabricator_id uuid [ref: > customers.id]
  slab_id uuid [ref: > slabs.id, note: "Nullable — if null, this is a global markup rule"]
  material_id uuid [ref: > materials.id, note: "Nullable — for per-material pricing"]
  markup_percentage decimal(5,2) [note: "Global or per-material markup over wholesale cost"]
  retail_price_cents bigint [note: "Explicit per-slab retail price override"]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]

  indexes {
    fabricator_id
    (fabricator_id, slab_id) [unique]
  }
}

// =============================================================================
// PORTAL: NOTIFICATIONS
// =============================================================================

Table notifications {
  id uuid [primary key]
  // Recipient is one of: internal user OR portal user
  recipient_user_id uuid [ref: > users.id]
  recipient_portal_user_id uuid [ref: > portal_users.id]

  notification_type varchar(100) [not null, note: "hold_approved, hold_declined, delivery_confirmed, new_message, hold_expiring, order_status_change, new_quote"]
  title varchar(255) [not null]
  body text

  // Link to related entity
  entity_type varchar(100)
  entity_id uuid

  is_read boolean [default: false]
  read_at timestamp
  email_sent boolean [default: false]
  email_sent_at timestamp

  created_at timestamp [default: `now()`]

  indexes {
    recipient_user_id
    recipient_portal_user_id
    is_read
    created_at
  }
}
